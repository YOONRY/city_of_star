display_name = "바르가"
description = "악마의 노예였다가 해방된 인간들입니다. 인간과 외관상 큰 차이는 없으나 덩치가 크고, 악마에 의한 타락 때문에 정신이 붕괴되었던 여파로 종족 단위의 광증에 시달립니다."
growth = SubResource("Resource_growth")
skill_ids = PackedStringArray("해방자의 광증")
